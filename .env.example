# انسخ الملف ده باسم .env وحط مفاتيحك المجانية
# الأساسي: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# احتياطي اختياري لو Gemini مشغول: https://console.groq.com/keys
GROQ_API_KEY=
# مزوّدين مجانيين زيادة (اختياري بس بيفرق جامد في السرعة لما Gemini وGroq يبقوا مشغولين):
# https://cloud.cerebras.ai  (بقى محتاج كارت دفع، فسيبه فاضي دلوقتي)
# CEREBRAS_API_KEY=
# https://openrouter.ai/keys  (بنستخدم الموديلات المجانية بس، حوالي 50 طلب في اليوم)
OPENROUTER_API_KEY=
# https://console.mistral.ai  (خطة مجانية من غير كارت)
MISTRAL_API_KEY=
# https://build.nvidia.com  (مجاني للتجربة والتطوير، حوالي 40 طلب في الدقيقة)
NVIDIA_API_KEY=
# Cloudflare Workers AI: https://dash.cloudflare.com  (10,000 وحدة في اليوم مجانًا)
# محتاج الاتنين: API token بصلاحية Workers AI، والـ Account ID
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# بحث الويب (عشان الـ agent يلاقي المتاجر بنفسه). حط واحد أو أكتر، كلهم مجانيين من غير كارت،
# والبحث بيتوزع عليهم فالحصة المجانية بتكفي أكتر، ولو واحد خلص التاني بيكمل:
# https://app.tavily.com  (1000 بحث في الشهر)
TAVILY_API_KEY=
# https://dashboard.exa.ai  (رصيد مجاني كل شهر)
EXA_API_KEY=
# https://www.firecrawl.dev  (1000 كريدت في الشهر، البحث بـ 2)
FIRECRAWL_API_KEY=
# BRAVE_API_KEY=  (الحسابات الجديدة بقت محتاجة كارت)
# اختياري: قارئ صفحات احتياطي بيشتغل من غير مفتاح، والمفتاح المجاني بيرفع الحد: https://jina.ai
# JINA_API_KEY=

# الموديلات بتتختار لوحدها من المتاح، ولو عايز تحدد واحد:
# GEMINI_MODEL=
# GROQ_MODEL=

# البلد اللي بندور فيها: EG (مصر) أو SA (السعودية) أو AE (الإمارات)
# MARKET=EG
# نفس الطلب خلال كام ساعة يرجع من قاعدة الأسعار على طول من غير ما يستهلك الحصص المجانية
# CACHE_HOURS=6

# لما الموقع يبقى أونلاين: كام بحث جديد في اليوم لكل زائر (0 = من غير حد). 5 مناسب للحصص المجانية.
# البحث المتكرر اللي راجع من الكاش مش بيتحسب.
# DAILY_LIMIT=5
# كلمة سر عشوائية بتتخلط مع IP الزائر قبل ما يتحفظ كـ hash (الـ IP نفسه مش بيتحفظ)
# CLIENT_SALT=
# للرفع على Hugging Face Spaces بـ python -m scripts.deploy_hf (توكن Write مجاني من huggingface.co/settings/tokens)
# HF_TOKEN=

# ---------- حسابات العملاء (تسجيل دخول بجوجل) ----------
# من غير GOOGLE_CLIENT_ID الموقع بيشتغل عادي من غير تسجيل دخول.
# مجاني: https://console.cloud.google.com/apis/credentials -> Create credentials -> OAuth client ID -> Web application
# وفي "Authorized JavaScript origins" حط http://localhost:8000 ولينك الموقع (https://dealhunter-opk9.onrender.com)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# كلمة سر طويلة عشوائية بتمضي كوكي تسجيل الدخول (على السيرفر لازم، وإلا الكل بيخرج مع كل ريستارت)
# SESSION_SECRET=
# قاعدة بيانات دايمة للحسابات (Supabase مجاني من غير كارت: Project -> Connect -> Session pooler).
# من غيرها بتتحفظ في data/prices.db، وده بيتمسح على Render مع كل ريستارت.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres
# كام بحث في اليوم للي عامل تسجيل دخول (0 = زي DAILY_LIMIT)
# USER_DAILY_LIMIT=15
# البلاد اللي البحث شغال فيها فعلاً (الباقي العميل يقدر يختاره، والنتايج تفضل من مصر لحد ما يتجهز)
# LIVE_MARKETS=EG
# إيميل تنبيه نزول السعر (اختياري): Brevo مجاني 300 إيميل في اليوم من غير كارت: https://app.brevo.com
# (Render المجاني بيقفل SMTP فـ Gmail SMTP مش هيشتغل هناك.) MAIL_FROM لازم يكون إيميل متأكد منه في Brevo.
# BREVO_API_KEY=
# MAIL_FROM=
# كلمة سر للفحص الدوري لأسعار المنتجات المتابَعة (نفسها في GitHub -> Settings -> Secrets: CRON_SECRET و SITE_URL)
# CRON_SECRET=

# ---------- لوحة التحكم /admin (الزوار والبحث والضغطات على المتاجر) ----------
# من غيرها الصفحة مقفولة خالص. متكتبهاش في الكود أبدًا (الريبو عام)، حطها هنا وفي Render -> Environment بس.
# ADMIN_PASSWORD=
# أكواد برامج الشراكة (Affiliate) بتاعة المتاجر، الموقع بيضيفها لوحده على لينكات المتجر:
# AFFILIATE_TAGS=amazon.eg: tag=yourcode-21; noon.com: utm_source=xxx
