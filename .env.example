# انسخ الملف ده باسم .env وحط مفاتيحك المجانية
# الأساسي: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# احتياطي اختياري لو Gemini مشغول: https://console.groq.com/keys
GROQ_API_KEY=
# مزوّدين مجانيين زيادة (اختياري بس بيفرق جامد في السرعة لما Gemini وGroq يبقوا مشغولين):
# https://cloud.cerebras.ai  (بقى محتاج كارت دفع، فسيبه فاضي دلوقتي)
# CEREBRAS_API_KEY=
# https://openrouter.ai/keys  (بنستخدم الموديلات المجانية بس، حوالي 50 طلب في اليوم)
OPENROUTER_API_KEY=
# https://console.mistral.ai  (خطة مجانية من غير كارت)
MISTRAL_API_KEY=
# https://build.nvidia.com  (مجاني للتجربة والتطوير، حوالي 40 طلب في الدقيقة)
NVIDIA_API_KEY=
# Cloudflare Workers AI: https://dash.cloudflare.com  (10,000 وحدة في اليوم مجانًا)
# محتاج الاتنين: API token بصلاحية Workers AI، والـ Account ID
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# بحث الويب (عشان الـ agent يلاقي المتاجر بنفسه). حط واحد أو أكتر، كلهم مجانيين من غير كارت،
# والبحث بيتوزع عليهم فالحصة المجانية بتكفي أكتر، ولو واحد خلص التاني بيكمل:
# https://app.tavily.com  (1000 بحث في الشهر)
TAVILY_API_KEY=
# https://dashboard.exa.ai  (رصيد مجاني كل شهر)
EXA_API_KEY=
# https://www.firecrawl.dev  (1000 كريدت في الشهر، البحث بـ 2)
FIRECRAWL_API_KEY=
# BRAVE_API_KEY=  (الحسابات الجديدة بقت محتاجة كارت)
# اختياري: قارئ صفحات احتياطي بيشتغل من غير مفتاح، والمفتاح المجاني بيرفع الحد: https://jina.ai
# JINA_API_KEY=

# الموديلات بتتختار لوحدها من المتاح، ولو عايز تحدد واحد:
# GEMINI_MODEL=
# GROQ_MODEL=

# البلد اللي بندور فيها: EG (مصر) أو SA (السعودية) أو AE (الإمارات)
# MARKET=EG
# نفس الطلب خلال كام ساعة يرجع من قاعدة الأسعار على طول من غير ما يستهلك الحصص المجانية
# CACHE_HOURS=6

# لما الموقع يبقى أونلاين: كام بحث جديد في اليوم لكل زائر (0 = من غير حد). 5 مناسب للحصص المجانية.
# البحث المتكرر اللي راجع من الكاش مش بيتحسب.
# DAILY_LIMIT=5
# كلمة سر عشوائية بتتخلط مع IP الزائر قبل ما يتحفظ كـ hash (الـ IP نفسه مش بيتحفظ)
# CLIENT_SALT=
# للرفع على Hugging Face Spaces بـ python -m scripts.deploy_hf (توكن Write مجاني من huggingface.co/settings/tokens)
# HF_TOKEN=
